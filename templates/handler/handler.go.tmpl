package handler

import (
	"context"
	"encoding/json"
	"net/http"

	"{{.Module}}/internal/model"
)

// {{.Pascal}}Service is the part of the service layer that the
// handler needs. Declaring the interface here (consumer side) keeps
// the handler independent of the concrete service implementation.
type {{.Pascal}}Service interface {
	Create(ctx context.Context, id, name string) (*model.{{.Pascal}}, error)
	Get(ctx context.Context, id string) (*model.{{.Pascal}}, error)
}

// {{.Pascal}}Handler exposes {{.Name}} endpoints over HTTP.
type {{.Pascal}}Handler struct {
	svc {{.Pascal}}Service
}

// New{{.Pascal}}Handler returns a handler wired to svc.
func New{{.Pascal}}Handler(svc {{.Pascal}}Service) *{{.Pascal}}Handler {
	return &{{.Pascal}}Handler{svc: svc}
}

// Register mounts the {{.Name}} routes on mux.
func (h *{{.Pascal}}Handler) Register(mux *http.ServeMux) {
	mux.HandleFunc("POST /{{.Name}}", h.create)
	mux.HandleFunc("GET /{{.Name}}/{id}", h.get)
}

func (h *{{.Pascal}}Handler) create(w http.ResponseWriter, r *http.Request) {
	var req struct {
		ID   string `json:"id"`
		Name string `json:"name"`
	}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		http.Error(w, "invalid JSON body", http.StatusBadRequest)
		return
	}
	m, err := h.svc.Create(r.Context(), req.ID, req.Name)
	if err != nil {
		http.Error(w, err.Error(), http.StatusInternalServerError)
		return
	}
	writeJSON(w, http.StatusCreated, m)
}

func (h *{{.Pascal}}Handler) get(w http.ResponseWriter, r *http.Request) {
	// A real handler would map service errors to 4xx/5xx precisely
	// (e.g. "not found" to 404); the sample collapses them for brevity.
	m, err := h.svc.Get(r.Context(), r.PathValue("id"))
	if err != nil {
		http.Error(w, err.Error(), http.StatusNotFound)
		return
	}
	writeJSON(w, http.StatusOK, m)
}
